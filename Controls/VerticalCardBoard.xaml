<UserControl x:Class="WpfSortableCardLayoutsDemo.Controls.VerticalCardBoard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent"
             UseLayoutRounding="True">
    <Border Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="14"
            Effect="{StaticResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="78" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Vertical Cards" />
                        <TextBlock Margin="0,5,0,0" FontSize="12.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Drag to reorder. Click a card to edit its parameters." />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center" Background="#F0FDF4"
                            BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#15803D" Text="VERTICAL" />
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="TrackRegion" Grid.Row="1" Background="#F8FAFC" ClipToBounds="True"
                  SizeChanged="TrackRegion_SizeChanged">
                <ScrollViewer x:Name="CardsScrollViewer" Background="#F8FAFC" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="TrackCanvas" Background="Transparent" />
                </ScrollViewer>

                <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
                    <Border x:Name="DragPreview" Height="70" Background="#FFFFFF" BorderBrush="#2563EB"
                            BorderThickness="2" CornerRadius="10" Opacity="0.95" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" Opacity="0.24" ShadowDepth="6" Color="#1E3A8A" />
                        </Border.Effect>
                        <Grid Margin="13,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Width="31" Height="31" VerticalAlignment="Center" Background="#2563EB"
                                    CornerRadius="7">
                                <TextBlock x:Name="PreviewSequenceText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewTitleText" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="#64748B" Text="Release to place" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18"
                                       Foreground="#64748B" Text="⋮⋮" />
                        </Grid>
                    </Border>
                </Canvas>

                <Border x:Name="OutsideWarning" Margin="0,12,0,0" Padding="12,7" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                        CornerRadius="7" Visibility="Collapsed">
                    <TextBlock FontSize="11.5" Foreground="#9A3412" Text="Move back into the panel to choose a drop position." />
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                <Grid Margin="20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="OrderSummaryText" VerticalAlignment="Bottom" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Row="1" Margin="0,7,0,10" Padding="10,6" Background="#F8FAFC"
                            CornerRadius="7">
                        <TextBlock x:Name="StatusText" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Ready. Click a card to edit its parameters." TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
